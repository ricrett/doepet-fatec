# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
# VITE_API_BASE_URL: Optional backend origin if frontend and API are deployed separately
# VITE_API_BASE_URL="https://doepet-api.example.com"
# CORS_ORIGIN: Comma-separated allowed origins when serving API cross-origin
# CORS_ORIGIN="https://doepet.example.com"

# =============================================================================
# DT-02: PostgreSQL (Azure Flexible Server / Cloud SQL / Docker)
# =============================================================================
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="doepet_db"
SQL_USER="doepet_app"
SQL_PASSWORD="change-me-app-password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change-me-admin-password"
SQL_SSL="false"

# =============================================================================
# DT-04: JWT RS256 & Azure Key Vault
# =============================================================================
# AZURE_KEY_VAULT_URL="https://doepet-kv.vault.azure.net/"
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# =============================================================================
# DT-03: Azure Service Bus (Mensageria Assíncrona & DLQ)
# =============================================================================
# AZURE_SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://doepet.servicebus.windows.net/;..."
AZURE_SERVICE_BUS_QUEUE="doepet-blood-alerts"

# =============================================================================
# DT-05: Observabilidade (OpenTelemetry & Azure Application Insights)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_SERVICE_NAME="doepet-api"

# =============================================================================
# DT-06: Web Push (VAPID) & FCM / Azure Notification Hubs
# =============================================================================
VAPID_SUBJECT="mailto:contato@doepet.com.br"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# FCM_SERVER_KEY=""
